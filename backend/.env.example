# 카카오 REST API 키 (전국 라이트 — 주변 음식점)
# https://developers.kakao.com/ 에서 발급 후 넣기
KAKAO_REST_API_KEY=

# 카카오 JavaScript 키 (웹 로그인 / 계정 병합)
KAKAO_JS_KEY=

# 배포 도메인 (공유/Duo 링크에 사용)
PUBLIC_BASE_URL=https://www.justthis.co.kr

