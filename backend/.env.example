# 카카오 REST API 키 (전국 라이트 — 주변 음식점)
# https://developers.kakao.com/ 에서 발급 후 넣기
KAKAO_REST_API_KEY=

# 카카오 JavaScript 키 (웹 로그인 / 계정 병합)
KAKAO_JS_KEY=

# 카카오 Client Secret (REST 키에서 Secret ON일 때 필수)
# 콘솔: 앱 > 플랫폼 키 > REST API 키 > 클라이언트 시크릿 코드
KAKAO_CLIENT_SECRET=

# Google Places 사진 파일럿. 서버에서만 사용하며, 장소 사진이 없으면 기존 카드로 돌아간다.
# Google Places API (New)와 결제 계정이 필요하다.
GOOGLE_PLACES_PHOTOS=off
GOOGLE_MAPS_API_KEY=

GUEST_SIGNING_SECRET=

# 배포 도메인 (공유/Duo 링크에 사용)
PUBLIC_BASE_URL=https://justthis.co.kr

# Analytics 대시보드 (/analytics) — 임의 문자열
ADMIN_TOKEN=

# 이벤트/유저 JSON을 쓸 경로. Render 영구 디스크를 붙였으면 마운트 경로(/data).
# 비우면 레포의 data/ 를 쓰는데, Render에서는 재배포·재시작마다 날아간다.
DATA_DIR=

# 방문 추천에 검증 메뉴를 붙일지. off면 기존 실상호 추천만 쓴다.
VERIFIED_MENUS_VISIT=on

# 송도 검수 페이지/API 공개. 비우면 DATA_DIR 없는 로컬만 공개, 운영은 숨김.
REVIEW_SONGDO=

# 선택: Firebase Web (Anonymous Auth)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
