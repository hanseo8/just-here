    "@capacitor/core": "8.4.3",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "8.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.0",
    "esbuild": "^0.25.0"
  }
}
